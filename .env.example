# Multi-Cloud Cost Intelligence Platform - Environment Variables
# Task 23.1: Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Redis Cache ───────────────────────────────────────────────────────────────
# Leave empty to use in-memory cache (development only)
REDIS_URL=
CACHE_TTL_HOURS=6
CACHE_BACKEND=memory

# ── Rate Limiting ─────────────────────────────────────────────────────────────
AWS_RATE_LIMIT=10
AZURE_RATE_LIMIT=20
GCP_RATE_LIMIT=15
DEFAULT_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── Provider API Keys (optional - most pricing APIs are public) ───────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_SUBSCRIPTION_ID=
# GCP_PROJECT_ID=
# GCP_API_KEY=

# ── Infracost Live Pricing API ────────────────────────────────────────────────
# Get a free API key at https://www.infracost.io/docs/integrations/environment_variables/
# Enables live per-region pricing from 10M+ curated prices across AWS, Azure, GCP.
INFRACOST_API_KEY=

# ── Currency API ──────────────────────────────────────────────────────────────
# Optional: for live exchange rates (falls back to static rates if not set)
EXCHANGE_RATE_API_KEY=

# ── Sharing ───────────────────────────────────────────────────────────────────
SHARE_TTL_DAYS=30
# DATABASE_URL=sqlite:///./shares.db

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Multi-Cloud Cost Intelligence
